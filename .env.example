# ---- paths and services ----
DATA_ROOT=/home/YOUR_USER/asr-data
DATABASE_URL=postgresql+psycopg://asr:asr@localhost:5432/asr
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local

# ---- S3 / MinIO (only when STORAGE_BACKEND=s3) ----
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=asr-audio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---- model backend: stub (Phase 2-3) or whisper (Phase 4+) ----
MODEL_BACKEND=stub
STUB_SLEEP_SECONDS=0.5
STUB_FAILURE_PROBABILITY=0.05
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VAD_BACKEND=silero

# ---- limits and workers ----
WORKER_CONCURRENCY=4
MAX_QUEUE_LENGTH=50000
DEFAULT_MAX_CONCURRENT_RUNS=100
